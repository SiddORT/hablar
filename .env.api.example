# Copy to .env.api on the operator's host, restrict permissions, and replace
# both placeholders. Never use these literal values or commit the filled file.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
SESSION_SECRET=REPLACE_WITH_EXISTING_STABLE_SECRET_OF_AT_LEAST_32_BYTES
# Optional waitlist email delivery; use values from the operator's secret store.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER_EMAIL
ADMIN_NOTIFICATION_EMAIL=REPLACE_WITH_HABLAR_ADMIN_EMAIL
