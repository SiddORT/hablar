{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uv run --project ../.. --locked uvicorn fastapi_app:app --app-dir . --host 0.0.0.0 --port ${PORT:-8080} --reload --no-access-log",
    "build": "uv sync --project ../.. --locked --no-dev",
    "start": "uv run --project ../.. --locked --no-sync uvicorn fastapi_app:app --app-dir . --host 0.0.0.0 --port ${PORT:-8080} --no-access-log"
  }
}
