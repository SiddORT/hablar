# Compose interpolation only; no credentials go here.
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
API_ENV_FILE=.env.api
# Verified public HTTPS origin, no path. Blank keeps website builds noindex.
# Consumed at WEBSITE BUILD TIME; changing it requires rebuilding the image.
SITE_ORIGIN=
# After publishing, set both to the SAME release or commit tag:
# WEBSITE_IMAGE=ghcr.io/owner/repository-website:sha-FULL_COMMIT_SHA
# API_IMAGE=ghcr.io/owner/repository-api:sha-FULL_COMMIT_SHA
