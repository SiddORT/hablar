# HTTP: redirect public requests to HTTPS.
server {
    listen 8081;
    server_name _;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main website over HTTP internally (health checks) and HTTPS publicly.
server {
    listen 8080;
    listen 8443 ssl;
    server_name uat-landing.hablar.co.in;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 4k;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream "${API_UPSTREAM}";

    location ~ ^/api(?:/|$) {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /brand/ {
        try_files $uri =404;
    }

    location = /privacy {
        try_files /privacy/index.html =404;
        add_header Cache-Control "no-cache";
    }

    location = /terms {
        try_files /terms/index.html =404;
        add_header Cache-Control "no-cache";
    }

    location = /robots.txt {
        try_files $uri =404;
    }

    location = /sitemap.xml {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}